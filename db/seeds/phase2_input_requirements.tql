# ═══════════════════════════════════════════════════════════════
# ── RELATIONS: subtask-requires-req ──
# ═══════════════════════════════════════════════════════════════
# Roles: (requiring-subtask: subtask, required-input: input-requirement)
# O28 is produced by T8.5 (Storage Specification), not S12 as in the design doc.
# All 8 O28 IRs are consumed by T8.5.

insert
$ir028_1_r isa input-requirement, has ir-id "IR-028-001";
$ir028_2_r isa input-requirement, has ir-id "IR-028-002";
$ir028_3_r isa input-requirement, has ir-id "IR-028-003";
$ir028_4_r isa input-requirement, has ir-id "IR-028-004";
$ir028_5_r isa input-requirement, has ir-id "IR-028-005";
$ir028_6_r isa input-requirement, has ir-id "IR-028-006";
$ir028_7_r isa input-requirement, has ir-id "IR-028-007";
$ir028_8_r isa input-requirement, has ir-id "IR-028-008";
$s12_r isa subtask, has subtask-id "T8.5";
(requiring-subtask: $s12_r, required-input: $ir028_1_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_2_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_3_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_4_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_5_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_6_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_7_r) isa subtask-requires-req;
(requiring-subtask: $s12_r, required-input: $ir028_8_r) isa subtask-requires-req;