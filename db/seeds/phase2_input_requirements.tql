# External inputs required by Phase 0 outputs
insert
$ir001_q isa input-requirement, has ir-id "IR-EXT-001";
$o1_q isa design-output, has output-id "O1";
(requiring-output: $o1_q, required-ir: $ir001_q) isa ir-required-by-output;

