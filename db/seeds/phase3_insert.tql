(depending-subtask: $T6_2, required-subtask: $T2_1) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T6_2, required-subtask: $T2_2) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T6_2, required-subtask: $T3_1) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T6_2, required-subtask: $T3_2) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T6_2, required-subtask: $T4_1) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T6_2, required-subtask: $T4_2) isa subtask-dependency, has dep-type "hard";
# T6.3 is continuous — no hard dependencies

# SG7
(depending-subtask: $T7_1, required-subtask: $T4_1) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T7_2, required-subtask: $T6_3) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T7_2, required-subtask: $T7_1) isa subtask-dependency, has dep-type "hard";

# SG8
(depending-subtask: $T8_1, required-subtask: $T1_1) isa subtask-dependency, has dep-type "hard";
(depending-subtask: $T8_1, required-subtask: $T1_3) isa subtask-dependency, has dep-type "hard";
