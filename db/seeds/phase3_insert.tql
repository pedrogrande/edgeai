# ─── SUBTASK → FAILURE MODE LINKS ───

(fm-subtask: $T1_1, fm-entity: $FM1) isa subtask-has-fm;
(fm-subtask: $T1_2, fm-entity: $FM2) isa subtask-has-fm;
(fm-subtask: $T1_3, fm-entity: $FM3) isa subtask-has-fm;
(fm-subtask: $T1_4, fm-entity: $FM4) isa subtask-has-fm;
(fm-subtask: $T1_5, fm-entity: $FM5) isa subtask-has-fm;
(fm-subtask: $T2_1, fm-entity: $FM6) isa subtask-has-fm;
(fm-subtask: $T2_2, fm-entity: $FM7) isa subtask-has-fm;
(fm-subtask: $T3_1, fm-entity: $FM8) isa subtask-has-fm;
(fm-subtask: $T3_2, fm-entity: $FM9) isa subtask-has-fm;
