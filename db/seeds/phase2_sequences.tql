# ─── PHASE 2: BACKCASTING — Phase Sequence & Phase-Output Relations ───
# TypeQL v3.10.1 compatible
#
# 9 phase-sequence relations (P0→P1→...→P9)
# 28 phase-produces-output relations (which phase produces which output)
#
# Note: Using phase-id for match (e.g. has phase-id "P0") since it's @key.
# Note: Using phase-produced-output role name (not produced-output) to avoid
#       ambiguity with subtask-produces:produced-output.

# ─── PHASE SEQUENCE: P0→P1→P2→...→P9 ───

insert
$p0 isa cawdp-phase, has phase-id "P0";
$p1 isa cawdp-phase, has phase-id "P1";
(predecessor-phase: $p0, successor-phase: $p1) isa phase-sequence;

insert
$p1 isa cawdp-phase, has phase-id "P1";
$p2 isa cawdp-phase, has phase-id "P2";
(predecessor-phase: $p1, successor-phase: $p2) isa phase-sequence;

insert
$p2 isa cawdp-phase, has phase-id "P2";
$p3 isa cawdp-phase, has phase-id "P3";
(predecessor-phase: $p2, successor-phase: $p3) isa phase-sequence;

insert
$p3 isa cawdp-phase, has phase-id "P3";
$p4 isa cawdp-phase, has phase-id "P4";
(predecessor-phase: $p3, successor-phase: $p4) isa phase-sequence;

insert
$p4 isa cawdp-phase, has phase-id "P4";
$p5 isa cawdp-phase, has phase-id "P5";
(predecessor-phase: $p4, successor-phase: $p5) isa phase-sequence;

insert
$p5 isa cawdp-phase, has phase-id "P5";
$p6 isa cawdp-phase, has phase-id "P6";
(predecessor-phase: $p5, successor-phase: $p6) isa phase-sequence;

insert
$p6 isa cawdp-phase, has phase-id "P6";
$p7 isa cawdp-phase, has phase-id "P7";
(predecessor-phase: $p6, successor-phase: $p7) isa phase-sequence;

insert
$p7 isa cawdp-phase, has phase-id "P7";
$p8 isa cawdp-phase, has phase-id "P8";
(predecessor-phase: $p7, successor-phase: $p8) isa phase-sequence;

insert
$p8 isa cawdp-phase, has phase-id "P8";
$p9 isa cawdp-phase, has phase-id "P9";
(predecessor-phase: $p8, successor-phase: $p9) isa phase-sequence;

# ─── PHASE-PRODUCES-OUTPUT RELATIONS ───
# Which phase produces which design-output

# P0 produces: O1, O2, O3, O4
insert
$p0 isa cawdp-phase, has phase-id "P0";
$o1 isa design-output, has output-id "O1";
(producing-phase: $p0, phase-produced-output: $o1) isa phase-produces-output;
$o2 isa design-output, has output-id "O2";
(producing-phase: $p0, phase-produced-output: $o2) isa phase-produces-output;
$o3 isa design-output, has output-id "O3";
(producing-phase: $p0, phase-produced-output: $o3) isa phase-produces-output;
$o4 isa design-output, has output-id "O4";
(producing-phase: $p0, phase-produced-output: $o4) isa phase-produces-output;

# P1 produces: O5-O28
insert
$p1 isa cawdp-phase, has phase-id "P1";
$o5 isa design-output, has output-id "O5";
