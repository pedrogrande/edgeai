(containing-group: $G3, grouped-output: $O13) isa output-group-membership;
(containing-group: $G3, grouped-output: $O14) isa output-group-membership;
(containing-group: $G4, grouped-output: $O15) isa output-group-membership;
(containing-group: $G4, grouped-output: $O16) isa output-group-membership;
(containing-group: $G5, grouped-output: $O17) isa output-group-membership;
(containing-group: $G5, grouped-output: $O18) isa output-group-membership;
(containing-group: $G6, grouped-output: $O19) isa output-group-membership;
(containing-group: $G6, grouped-output: $O20) isa output-group-membership;
(containing-group: $G6, grouped-output: $O21) isa output-group-membership;
(containing-group: $G7, grouped-output: $O22) isa output-group-membership;
(containing-group: $G7, grouped-output: $O23) isa output-group-membership;
(containing-group: $G8, grouped-output: $O24) isa output-group-membership;
(containing-group: $G8, grouped-output: $O25) isa output-group-membership;
(containing-group: $G8, grouped-output: $O26) isa output-group-membership;
(containing-group: $G8, grouped-output: $O27) isa output-group-membership;
(containing-group: $G8, grouped-output: $O28) isa output-group-membership;

# ─── OUTPUT DEPENDENCIES (85 edges) ───

# O2 chain
(depending-output: $O2, required-output: $O1) isa output-dependency, has dependency-strength "hard";

# O3 chain
(depending-output: $O3, required-output: $O1) isa output-dependency, has dependency-strength "hard";
(depending-output: $O3, required-output: $O2) isa output-dependency, has dependency-strength "hard";

# O4 chain
(depending-output: $O4, required-output: $O1) isa output-dependency, has dependency-strength "hard";
(depending-output: $O4, required-output: $O2) isa output-dependency, has dependency-strength "hard";
(depending-output: $O4, required-output: $O3) isa output-dependency, has dependency-strength "hard";

