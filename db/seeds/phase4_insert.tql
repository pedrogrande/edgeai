# ─── PHASE 4: CAPABILITY ALLOCATION SEED ───
# Inserts 24 allocation entities + 24 subtask-has-allocation relations
# Then inserts 10 decision-authority entities + 10 subtask-has-authority relations
#
# Role attribute rules (per plan decision):
#   - human-role, agent-role, system-role are OMITTED when the actor has no role
#   - Never store "" — absence is the correct representation
#   - Absence is queryable: match $a isa allocation, not { $a has system-role $sr; };
#
# Scores from complementarity matrix in spec.
# complementarity-gap = judgment-demand - pattern-capacity (can be negative).

match
    $T1_1 isa subtask, has subtask-id "T1.1";
    $T1_2 isa subtask, has subtask-id "T1.2";
    $T1_3 isa subtask, has subtask-id "T1.3";
    $T1_4 isa subtask, has subtask-id "T1.4";
    $T1_5 isa subtask, has subtask-id "T1.5";
    $T2_1 isa subtask, has subtask-id "T2.1";
    $T2_2 isa subtask, has subtask-id "T2.2";
    $T3_1 isa subtask, has subtask-id "T3.1";
    $T3_2 isa subtask, has subtask-id "T3.2";
    $T4_1 isa subtask, has subtask-id "T4.1";
    $T4_2 isa subtask, has subtask-id "T4.2";
    $T5_1 isa subtask, has subtask-id "T5.1";
    $T5_2 isa subtask, has subtask-id "T5.2";
    $T5_3 isa subtask, has subtask-id "T5.3";
    $T6_1 isa subtask, has subtask-id "T6.1";
    $T6_2 isa subtask, has subtask-id "T6.2";
    $T6_3 isa subtask, has subtask-id "T6.3";
    $T7_1 isa subtask, has subtask-id "T7.1";
    $T7_2 isa subtask, has subtask-id "T7.2";
    $T8_1 isa subtask, has subtask-id "T8.1";
    $T8_2 isa subtask, has subtask-id "T8.2";
    $T8_3 isa subtask, has subtask-id "T8.3";
    $T8_4 isa subtask, has subtask-id "T8.4";
    $T8_5 isa subtask, has subtask-id "T8.5";
insert

# ── SG1: Identity ──────────────────────────────────────────────────────────────

$A1_1 isa allocation,
    has alloc-id "ALLOC-T1.1",
    has subtask-ref "T1.1",
    has judgment-demand 9,
    has pattern-capacity 2,
    has determinism-fit 0,
    has complementarity-gap 7,
    has primary-actor "human",
    has allocation-mode "human_primary",
    has reversibility "low",
    has confidence-class "low",
    has cr-class "Low/Low",
    has human-role "Articulates purpose, names anti-goals",
    has agent-role "Reflects words back, surfaces tensions";
(allocated-subtask: $T1_1, allocation-record: $A1_1) isa subtask-has-allocation;

$A1_2 isa allocation,
    has alloc-id "ALLOC-T1.2",
    has subtask-ref "T1.2",
    has judgment-demand 8,
    has pattern-capacity 4,
    has determinism-fit 2,
    has complementarity-gap 4,
    has primary-actor "human",
    has allocation-mode "collaborative",
    has reversibility "low",
    has confidence-class "medium",
    has cr-class "Med/Low",
    has human-role "Decides class from 5 options",
    has agent-role "Presents taxonomy with evidence for each",
    has system-role "Validates classification is complete";
(allocated-subtask: $T1_2, allocation-record: $A1_2) isa subtask-has-allocation;

$A1_3 isa allocation,
    has alloc-id "ALLOC-T1.3",
    has subtask-ref "T1.3",
    has judgment-demand 9,
    has pattern-capacity 3,
    has determinism-fit 1,
    has complementarity-gap 6,
    has primary-actor "human",
    has allocation-mode "human_primary",
    has reversibility "medium",
    has confidence-class "low",
    has cr-class "Low/Med",
    has human-role "Draws inside/outside line",
    has agent-role "Surfaces edge cases, stress-tests boundaries";
(allocated-subtask: $T1_3, allocation-record: $A1_3) isa subtask-has-allocation;

$A1_4 isa allocation,
    has alloc-id "ALLOC-T1.4",
    has subtask-ref "T1.4",
    has judgment-demand 4,
    has pattern-capacity 8,
    has determinism-fit 2,
    has complementarity-gap -4,
    has primary-actor "agent",
    has allocation-mode "agent_primary",
    has reversibility "high",
    has confidence-class "medium",
    has cr-class "Med/High",
    has human-role "Reviews, approves",
    has agent-role "Drafts from O1-O3 + schema_registry",
    has system-role "Validates schema compliance";
(allocated-subtask: $T1_4, allocation-record: $A1_4) isa subtask-has-allocation;

$A1_5 isa allocation,
    has alloc-id "ALLOC-T1.5",
    has subtask-ref "T1.5",
    has judgment-demand 7,
    has pattern-capacity 6,
    has determinism-fit 4,
    has complementarity-gap 1,
    has primary-actor "human",
    has allocation-mode "collaborative",
    has reversibility "low",
    has confidence-class "medium",
    has cr-class "Med/Low",
    has human-role "Decides enforcement regime, revert granularity",
    has agent-role "Drafts contract from job description + authority class",
    has system-role "Validates guard testability";
(allocated-subtask: $T1_5, allocation-record: $A1_5) isa subtask-has-allocation;

