# ── Decision Authority Register ─────────────────────────────────────────────────

$DA1 isa decision-authority,
    has da-id "DA1",
    has da-description "What is this agent's purpose?",
    has da-authority "human_only",
    has da-trigger "Start of Phase 0",
    has da-escalation "Cannot proceed without answer";
(authority-holding-subtask: $T1_1, da-record: $DA1) isa subtask-has-authority;

$DA2 isa decision-authority,
    has da-id "DA2",
    has da-description "What authority class?",
    has da-authority "human_decides_agent_prepares",
    has da-trigger "After purpose stated",
    has da-escalation "Wrong class → rebuild contracts";
(authority-holding-subtask: $T1_2, da-record: $DA2) isa subtask-has-authority;

$DA3 isa decision-authority,
