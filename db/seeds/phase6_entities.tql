# ════════════════════════════════════════════════════════════════════════════════
# TEMPLATE TYPES: 7 types (5 instantiated now, 2 deferred to Phase 8)
# ════════════════════════════════════════════════════════════════════════════════

$TT_Input isa template-type,
    has tt-id "TT-Input",
    has tt-name "Input",
    has tt-description "Standardised input schema for a subtask",
    has tt-usage-count 3;

$TT_Output isa template-type,
    has tt-id "TT-Output",
    has tt-name "Output",
    has tt-description "Standardised output schema (the 28 design outputs)",
    has tt-usage-count 5;

$TT_Handoff isa template-type,
    has tt-id "TT-Handoff",
    has tt-name "Handoff",
    has tt-description "Interface contract between subtasks or stages",
    has tt-usage-count 2;

$TT_Verification isa template-type,
    has tt-id "TT-Verification",
    has tt-name "Verification",
    has tt-description "Quality gate assertion template",
    has tt-usage-count 9;

$TT_Decision isa template-type,
    has tt-id "TT-Decision",
    has tt-name "Decision",
    has tt-description "Decision capture template with why field",
    has tt-usage-count 10;

$TT_Feedback isa template-type,
    has tt-id "TT-Feedback",
    has tt-name "Feedback",
    has tt-description "User feedback capture for progressive autonomy",
    has tt-usage-count 0;

$TT_Escalation isa template-type,
    has tt-id "TT-Escalation",
    has tt-name "Escalation",
    has tt-description "Escalation protocol template",
    has tt-usage-count 0;

# ════════════════════════════════════════════════════════════════════════════════
# TEMPLATE INSTANCES: TI-01 through TI-12
# ════════════════════════════════════════════════════════════════════════════════

$TI_01 isa template-instance,
    has ti-id "TI-01",
    has ti-template-type-ref "TT-Input",
    has ti-subtask-ref "T1.1",
    has ti-specialisation "Purpose Input — human articulates purpose and anti-goals",
    has ti-schema "{purpose_statement: string, anti_goals: string[], principal_declared: bool}";

$TI_02 isa template-instance,
    has ti-id "TI-02",
    has ti-template-type-ref "TT-Input",
    has ti-subtask-ref "T1.3",
    has ti-specialisation "Scope Input — human draws inside/outside boundary",
    has ti-schema "{inside_scope: string[], outside_scope: string[], escalation_triggers: string[]}";

$TI_03 isa template-instance,
    has ti-id "TI-03",
    has ti-template-type-ref "TT-Input",
    has ti-subtask-ref "T1.2",
    has ti-specialisation "Authority Class Input — human selects from 5-class taxonomy",
    has ti-schema "{authority_class: extractor|measurer|assessor|generator|aggregator, evidence: string}";

$TI_04 isa template-instance,
    has ti-id "TI-04",
    has ti-template-type-ref "TT-Output",
    has ti-subtask-ref "T1.1",
    has ti-specialisation "Agent Identity Card (O1) — purpose, anti-goals, authority class",
    has ti-schema "{purpose: string, anti_goals: string[], authority_class: string, principal: string}";

$TI_05 isa template-instance,
    has ti-id "TI-05",
    has ti-template-type-ref "TT-Output",
    has ti-subtask-ref "T1.4",
    has ti-specialisation "Job Description (O3) — implementable by Agno dev",
    has ti-schema "{job_desc: string, authority_boundary: string, input_schema: string, output_schema: string}";

$TI_06 isa template-instance,
    has ti-id "TI-06",
    has ti-template-type-ref "TT-Output",
    has ti-subtask-ref "T1.5",
    has ti-specialisation "Contract Schema (O5) — enforcement regime and guards",
    has ti-schema "{contract_id: string, enforcement_regime: string, guards: guard[], revert_granularity: string}";

$TI_07 isa template-instance,
    has ti-id "TI-07",
    has ti-template-type-ref "TT-Output",
    has ti-subtask-ref "T6.1",
    has ti-specialisation "Boundary Map View (O19) — 5-minute readable boundary map",
    has ti-schema "{boundary_map: string, inside_scope: string[], outside_scope: string[], escalation_paths: string[]}";

$TI_08 isa template-instance,
    has ti-id "TI-08",
    has ti-template-type-ref "TT-Output",
    has ti-subtask-ref "T6.2",
    has ti-specialisation "Ops Manual View (O20) — insurer-readable operations manual",
    has ti-schema "{ops_manual: string, decision_log: decision[], override_procedures: string[], monitoring_schedule: string}";

$TI_09 isa template-instance,
    has ti-id "TI-09",
    has ti-template-type-ref "TT-Handoff",
    has ti-subtask-ref "—",
    has ti-specialisation "Stage Handoff — purpose → scope transition",
    has ti-schema "{from_stage: string, to_stage: string, artefact_ids: string[], gate_assertions: string[], pending_decisions: string[]}";

$TI_10 isa template-instance,
    has ti-id "TI-10",
    has ti-template-type-ref "TT-Handoff",
    has ti-subtask-ref "T1.4",
    has ti-specialisation "Subtask Handoff — job desc → contract",
    has ti-schema "{from_subtask: string, to_subtask: string, output_ref: string, input_requirements: string[], quality_check: string}";

$TI_11 isa template-instance,
    has ti-id "TI-11",
    has ti-template-type-ref "TT-Verification",
    has ti-subtask-ref "—",
    has ti-specialisation "Gate Assertion — parameterised per gate G1-G9",
    has ti-schema "{gate_id: string, assertions: assertion[], required_pass_count: int, actual_pass_count: int}";

$TI_12 isa template-instance,
    has ti-id "TI-12",
    has ti-template-type-ref "TT-Decision",
    has ti-subtask-ref "—",
    has ti-specialisation "Decision Record — decision, options, chosen, reasoning, authority",
    has ti-schema "{decision_id: string, question: string, options: string[], chosen: string, reasoning: string, authority: string}";

# ════════════════════════════════════════════════════════════════════════════════
# COMPOSITION CONFIG: CC1
# ════════════════════════════════════════════════════════════════════════════════

$CC1 isa composition-config,
    has cc-id "CC1",
    has cc-type "workflow",
    has cc-justification "Stages are sequential and gated; subtasks within stages can parallelise; state flows forward through defined outputs",
    has cc-agno-mapping "Agno Workflow with step_choices for conditional routing and Session for persistence",
    has cc-steps "[{stage: S1, name: Purpose, subtasks: [T1.1, T1.2], gate: G1}, {stage: S2, name: Scope, subtasks: [T1.3, T8.1], gate: G2, parallel: true}, {stage: S3, name: Specification, subtasks: [T1.4, T1.5, T3.1], gate: G3, parallel: true}, {stage: S4, name: Templating, subtasks: [T2.1, T4.2, T8.2], gate: G4, parallel: true}, {stage: S5, name: Validation, subtasks: [T2.2, T3.2, T4.1, T8.3, T8.4], gate: G5, parallel: true}, {stage: S6, name: Generation, subtasks: [T5.1, T5.2, T6.1, T6.2, T6.3, T8.5], gate: G6, parallel: true}, {stage: S7, name: Integration, subtasks: [T5.3, T7.1, T7.2], gate: G7, parallel: true}, {stage: S8, name: Completion, subtasks: [], gate: G8}, {stage: S9, name: Monitoring, subtasks: [], gate: G9}]",
    has cc-step-choices "{S2: {parallel: [T1.3, T8.1]}, S3: {after_E5: [T3.1]}, S4: {parallel: [T2.1, T4.2, T8.2]}, S5: {parallel: [T2.2, T3.2, T4.1, T8.3, T8.4]}, S6: {sequential: [T5.1, T5.2], parallel: [T6.1, T6.2, T6.3, T8.5]}, S7: {sequential_first: [T5.3], then_parallel: [T7.1, T7.2]}}",
    has cc-session-config "{storage: PostgresDb, table: agent_design_sessions, session_model: persistent_session_linked, state_sharing: session_state_plus_typedb}";

# ════════════════════════════════════════════════════════════════════════════════
# FALLBACK TIERS: 18 entries (4 Tier 1 + 4 Tier 2 + 6 Tier 3 + 4 Tier 4)
# ════════════════════════════════════════════════════════════════════════════════

# ── Tier 1: Retry Same Agent (Same Inputs + Constraint) ──

$FT1_1 isa fallback-tier,
    has ft-id "FT-T1.1",
    has ft-tier 1,
    has ft-name "retry_same_agent",
    has ft-trigger "Purpose unclear after first attempt",
    has ft-action "Add reflection prompt, what if you had an agent that…",
    has ft-max-attempts 3,
    has ft-preserve-state "true";

$FT1_2 isa fallback-tier,
    has ft-id "FT-T2.1",
    has ft-tier 1,
    has ft-name "retry_same_agent",
    has ft-trigger "Template inconsistency detected",
    has ft-action "Add cross-template consistency constraint",
    has ft-max-attempts 3,
    has ft-preserve-state "true";

$FT1_3 isa fallback-tier,
    has ft-id "FT-T5.1",
    has ft-tier 1,
    has ft-name "retry_same_agent",
    has ft-trigger "Schema validation failure",
    has ft-action "Add schema_registry schema as strict constraint",
    has ft-max-attempts 3,
    has ft-preserve-state "true";

$FT1_4 isa fallback-tier,
    has ft-id "FT-T5.2",
    has ft-tier 1,
    has ft-name "retry_same_agent",
    has ft-trigger "Test coverage below 80%",
    has ft-action "Add FMEA failure scenarios as required test cases",
    has ft-max-attempts 3,
    has ft-preserve-state "true";

# ── Tier 2: Retry Restricted (Reduced Scope + Stricter Guard) ──

$FT2_1 isa fallback-tier,
    has ft-id "FT-T1.2",
