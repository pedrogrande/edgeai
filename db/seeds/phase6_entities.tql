# ─── PHASE 6: SYSTEM ARCHITECTURE SEED — ENTITIES ──
# Inserts 9 pipeline-stages, 1 orchestration-config, 5 orchestration-decisions,
# 14 FMEA entries, 7 template-types, 12 template-instances,
# 1 composition-config, 18 fallback-tiers
#
# Total: 67 entities
#
# String ref convention (consistent with Phase 4 allocation.subtask-ref):
#   - fmea-subtask-ref, fmea-failure-ref, fmea-event-ref → string IDs (not TypeDB relations)
#   - ti-template-type-ref, ti-subtask-ref → string IDs
#   - stage-entry-event, stage-exit-event, stage-gate-ref → string IDs
#
# Omit empty attributes (Phase 4 decision): never store "" — absence is queryable

insert

# ════════════════════════════════════════════════════════════════════════════════
# PIPELINE STAGES: S1-S9
# ════════════════════════════════════════════════════════════════════════════════

$S1 isa pipeline-stage,
    has stage-id "S1",
    has stage-name "Purpose",
    has stage-description "Define agent purpose, anti-goals, and authority class",
    has stage-ordinal 1,
    has stage-gate-ref "G1",
    has stage-entry-event "E1",
    has stage-exit-event "E3",
    has stage-parallel false;

$S2 isa pipeline-stage,
    has stage-id "S2",
    has stage-name "Scope",
    has stage-description "Draw inside/outside scope boundary and audit tools",
    has stage-ordinal 2,
    has stage-gate-ref "G2",
    has stage-entry-event "E3",
    has stage-exit-event "E4",
    has stage-parallel true;

$S3 isa pipeline-stage,
    has stage-id "S3",
    has stage-name "Specification",
    has stage-description "Draft job description, contract architecture, and relational profile",
    has stage-ordinal 3,
    has stage-gate-ref "G3",
    has stage-entry-event "E4",
    has stage-exit-event "E6",
    has stage-parallel true;

$S4 isa pipeline-stage,
    has stage-id "S4",
    has stage-name "Templating",
    has stage-description "Generate 8 contract template specialisations with consistency check",
    has stage-ordinal 4,
    has stage-gate-ref "G4",
    has stage-entry-event "E6",
    has stage-exit-event "E8",
    has stage-parallel true;

$S5 isa pipeline-stage,
    has stage-id "S5",
    has stage-name "Validation",
    has stage-description "Validate templates in isolation and combination; quality gates pass",
    has stage-ordinal 5,
    has stage-gate-ref "G5",
    has stage-entry-event "E8",
    has stage-exit-event "E9",
    has stage-parallel true;

$S6 isa pipeline-stage,
    has stage-id "S6",
    has stage-name "Generation",
    has stage-description "Generate Agno code, test suite, and artefact views",
    has stage-ordinal 6,
    has stage-gate-ref "G6",
    has stage-entry-event "E9",
    has stage-exit-event "E13",
    has stage-parallel true;

$S7 isa pipeline-stage,
    has stage-id "S7",
    has stage-name "Integration",
    has stage-description "Integration validation, pattern identification, and curriculum drafting",
    has stage-ordinal 7,
    has stage-gate-ref "G7",
    has stage-entry-event "E13",
    has stage-exit-event "E15",
    has stage-parallel true;

$S8 isa pipeline-stage,
    has stage-id "S8",
    has stage-name "Completion",
    has stage-description "Assemble final artefact graph and verify all 28 outputs",
    has stage-ordinal 8,
    has stage-gate-ref "G8",
    has stage-entry-event "E15",
    has stage-exit-event "E16",
    has stage-parallel false;

$S9 isa pipeline-stage,
    has stage-id "S9",
    has stage-name "Monitoring",
    has stage-description "Continuous specification aging, memory governance, and boundary drift monitoring",
    has stage-ordinal 9,
    has stage-gate-ref "G9",
    has stage-entry-event "E16",
    has stage-exit-event "Ongoing",
    has stage-parallel false;

# ════════════════════════════════════════════════════════════════════════════════
# ORCHESTRATION CONFIG: OC1
# ════════════════════════════════════════════════════════════════════════════════

$OC1 isa orchestration-config,
    has oc-id "OC1",
    has oc-composition-type "workflow",
    has oc-orchestration-pattern "sequential_with_conditional_parallelism",
    has oc-session-model "persistent_session_linked",
    has oc-state-sharing "session_state_plus_typedb",
    has oc-fallback-tier-limit 3;

# ════════════════════════════════════════════════════════════════════════════════
# ORCHESTRATION DECISIONS: OD1-OD5
# ════════════════════════════════════════════════════════════════════════════════

$OD1 isa orchestration-decision,
    has od-id "OD1",
    has od-question "Composition type?",
    has od-chosen "Workflow",
    has od-reason "Stages are sequential and gated; subtasks within stages can parallelise; state flows forward through defined outputs",
    has od-alternatives "Team (no persistent roles — agents specialise per subtask, not per stage); Single agent (too many subtasks for one context window)";

$OD2 isa orchestration-decision,
    has od-id "OD2",
    has od-question "Orchestration pattern?",
    has od-chosen "Sequential with conditional parallelism",
    has od-reason "Stages run sequentially (gate dependencies); subtasks within stages parallelise where Phase 4 dependencies allow",
    has od-alternatives "Pure sequential (wastes parallelism opportunity); Event-driven (over-engineered for 9 stages)";

$OD3 isa orchestration-decision,
    has od-id "OD3",
    has od-question "Session model?",
    has od-chosen "Persistent, session-linked",
    has od-reason "Agent design spans hours/days; artefact graph must persist between sessions; user returns to continue where they left off",
    has od-alternatives "Ephemeral (loses context); Single-session (unrealistic for non-trivial agents)";

$OD4 isa orchestration-decision,
    has od-id "OD4",
    has od-question "State sharing?",
    has od-chosen "Session state + shared TypeDB",
    has od-reason "Session state for orchestration metadata (current stage, active subtasks); TypeDB for artefact graph (the real state); session metadata holds fragment IDs, TypeDB holds fragments",
    has od-alternatives "Session state only (can't query artefact graph); Event stream only (no direct query)";

$OD5 isa orchestration-decision,
    has od-id "OD5",
    has od-question "Fallback depth?",
    has od-chosen "3 tiers max",
    has od-reason "Tier 1 (retry), Tier 2 (restricted retry), Tier 3 (escalate human). Tier 4 (halt) is emergency only. Prevents infinite fallback loops",
    has od-alternatives "Unlimited (dangerous); 1 tier only (too aggressive)";

