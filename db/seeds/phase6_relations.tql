# ─── PHASE 6: SYSTEM ARCHITECTURE SEED — RELATIONS ──
# Links pipeline-stages to subtasks, stages to stages, orchestration decisions,
# template instances to types, and subtasks to fallback tiers.
# Requires phase6_entities to be applied first (stages, configs, decisions, templates, fallbacks)
# Requires Phase 3 subtask entities to exist

match
    # Pipeline stages
    $S1 isa pipeline-stage, has stage-id "S1";
    $S2 isa pipeline-stage, has stage-id "S2";
    $S3 isa pipeline-stage, has stage-id "S3";
    $S4 isa pipeline-stage, has stage-id "S4";
    $S5 isa pipeline-stage, has stage-id "S5";
    $S6 isa pipeline-stage, has stage-id "S6";
    $S7 isa pipeline-stage, has stage-id "S7";
    $S8 isa pipeline-stage, has stage-id "S8";
    $S9 isa pipeline-stage, has stage-id "S9";

    # Subtasks (Phase 3)
    $T1_1 isa subtask, has subtask-id "T1.1";
    $T1_2 isa subtask, has subtask-id "T1.2";
    $T1_3 isa subtask, has subtask-id "T1.3";
    $T1_4 isa subtask, has subtask-id "T1.4";
    $T1_5 isa subtask, has subtask-id "T1.5";
    $T2_1 isa subtask, has subtask-id "T2.1";
    $T2_2 isa subtask, has subtask-id "T2.2";
    $T3_1 isa subtask, has subtask-id "T3.1";
    $T3_2 isa subtask, has subtask-id "T3.2";
    $T4_1 isa subtask, has subtask-id "T4.1";
    $T4_2 isa subtask, has subtask-id "T4.2";
    $T5_1 isa subtask, has subtask-id "T5.1";
    $T5_2 isa subtask, has subtask-id "T5.2";
    $T5_3 isa subtask, has subtask-id "T5.3";
    $T6_1 isa subtask, has subtask-id "T6.1";
    $T6_2 isa subtask, has subtask-id "T6.2";
    $T6_3 isa subtask, has subtask-id "T6.3";
    $T7_1 isa subtask, has subtask-id "T7.1";
    $T7_2 isa subtask, has subtask-id "T7.2";
    $T8_1 isa subtask, has subtask-id "T8.1";
    $T8_2 isa subtask, has subtask-id "T8.2";
    $T8_3 isa subtask, has subtask-id "T8.3";
    $T8_4 isa subtask, has subtask-id "T8.4";
    $T8_5 isa subtask, has subtask-id "T8.5";

    # Orchestration config
    $OC1 isa orchestration-config, has oc-id "OC1";

    # Orchestration decisions
    $OD1 isa orchestration-decision, has od-id "OD1";
    $OD2 isa orchestration-decision, has od-id "OD2";
    $OD3 isa orchestration-decision, has od-id "OD3";
    $OD4 isa orchestration-decision, has od-id "OD4";
    $OD5 isa orchestration-decision, has od-id "OD5";

    # Template types
    $TT_Input isa template-type, has tt-id "TT-Input";
    $TT_Output isa template-type, has tt-id "TT-Output";
    $TT_Handoff isa template-type, has tt-id "TT-Handoff";
    $TT_Verification isa template-type, has tt-id "TT-Verification";
    $TT_Decision isa template-type, has tt-id "TT-Decision";

    # Template instances
    $TI_01 isa template-instance, has ti-id "TI-01";
    $TI_02 isa template-instance, has ti-id "TI-02";
    $TI_03 isa template-instance, has ti-id "TI-03";
    $TI_04 isa template-instance, has ti-id "TI-04";
    $TI_05 isa template-instance, has ti-id "TI-05";
    $TI_06 isa template-instance, has ti-id "TI-06";
    $TI_07 isa template-instance, has ti-id "TI-07";
    $TI_08 isa template-instance, has ti-id "TI-08";
    $TI_09 isa template-instance, has ti-id "TI-09";
    $TI_10 isa template-instance, has ti-id "TI-10";
    $TI_11 isa template-instance, has ti-id "TI-11";
    $TI_12 isa template-instance, has ti-id "TI-12";

    # Fallback tiers (Tier 1-3 only; Tier 4 has no subtask links)
    $FT1_1 isa fallback-tier, has ft-id "FT-T1.1";
    $FT1_2 isa fallback-tier, has ft-id "FT-T2.1";
    $FT1_3 isa fallback-tier, has ft-id "FT-T5.1";
    $FT1_4 isa fallback-tier, has ft-id "FT-T5.2";
    $FT2_1 isa fallback-tier, has ft-id "FT-T1.2";
    $FT2_2 isa fallback-tier, has ft-id "FT-T2.2";
    $FT2_3 isa fallback-tier, has ft-id "FT-T5.3";
    $FT2_4 isa fallback-tier, has ft-id "FT-T8.2";
    $FT3_1 isa fallback-tier, has ft-id "FT-T1.1-H";
    $FT3_2 isa fallback-tier, has ft-id "FT-T1.3-H";
    $FT3_3 isa fallback-tier, has ft-id "FT-T1.5-H";
    $FT3_4 isa fallback-tier, has ft-id "FT-T3.1-H";
    $FT3_5 isa fallback-tier, has ft-id "FT-T5.3-H";
    $FT3_6 isa fallback-tier, has ft-id "FT-T8.4-H";

insert

# ════════════════════════════════════════════════════════════════════════════════
# STAGE-CONTAINS: Subtasks per stage
# S1: T1.1, T1.2 | S2: T1.3, T8.1 | S3: T1.4, T1.5, T3.1 | S4: T2.1, T4.2, T8.2
# S5: T2.2, T3.2, T4.1, T8.3, T8.4 | S6: T5.1, T5.2, T6.1, T6.2, T6.3, T8.5
# S7: T5.3, T7.1, T7.2 | S8: (none) | S9: (none)
# ════════════════════════════════════════════════════════════════════════════════

(stage-containing: $S1, stage-contained-subtask: $T1_1) isa stage-contains;
(stage-containing: $S1, stage-contained-subtask: $T1_2) isa stage-contains;

(stage-containing: $S2, stage-contained-subtask: $T1_3) isa stage-contains;
(stage-containing: $S2, stage-contained-subtask: $T8_1) isa stage-contains;

(stage-containing: $S3, stage-contained-subtask: $T1_4) isa stage-contains;
(stage-containing: $S3, stage-contained-subtask: $T1_5) isa stage-contains;
(stage-containing: $S3, stage-contained-subtask: $T3_1) isa stage-contains;

(stage-containing: $S4, stage-contained-subtask: $T2_1) isa stage-contains;
(stage-containing: $S4, stage-contained-subtask: $T4_2) isa stage-contains;
(stage-containing: $S4, stage-contained-subtask: $T8_2) isa stage-contains;

(stage-containing: $S5, stage-contained-subtask: $T2_2) isa stage-contains;
(stage-containing: $S5, stage-contained-subtask: $T3_2) isa stage-contains;
(stage-containing: $S5, stage-contained-subtask: $T4_1) isa stage-contains;
(stage-containing: $S5, stage-contained-subtask: $T8_3) isa stage-contains;
(stage-containing: $S5, stage-contained-subtask: $T8_4) isa stage-contains;

(stage-containing: $S6, stage-contained-subtask: $T5_1) isa stage-contains;
(stage-containing: $S6, stage-contained-subtask: $T5_2) isa stage-contains;
(stage-containing: $S6, stage-contained-subtask: $T6_1) isa stage-contains;
(stage-containing: $S6, stage-contained-subtask: $T6_2) isa stage-contains;
(stage-containing: $S6, stage-contained-subtask: $T6_3) isa stage-contains;
(stage-containing: $S6, stage-contained-subtask: $T8_5) isa stage-contains;

(stage-containing: $S7, stage-contained-subtask: $T5_3) isa stage-contains;
(stage-containing: $S7, stage-contained-subtask: $T7_1) isa stage-contains;
(stage-containing: $S7, stage-contained-subtask: $T7_2) isa stage-contains;

# ════════════════════════════════════════════════════════════════════════════════
# STAGE-SEQUENCE: S1 → S2 → S3 → S4 → S5 → S6 → S7 → S8 → S9
# ════════════════════════════════════════════════════════════════════════════════

(preceding-stage: $S1, succeeding-stage: $S2) isa stage-sequence;
(preceding-stage: $S2, succeeding-stage: $S3) isa stage-sequence;
(preceding-stage: $S3, succeeding-stage: $S4) isa stage-sequence;
(preceding-stage: $S4, succeeding-stage: $S5) isa stage-sequence;
(preceding-stage: $S5, succeeding-stage: $S6) isa stage-sequence;
(preceding-stage: $S6, succeeding-stage: $S7) isa stage-sequence;
(preceding-stage: $S7, succeeding-stage: $S8) isa stage-sequence;
(preceding-stage: $S8, succeeding-stage: $S9) isa stage-sequence;

# ════════════════════════════════════════════════════════════════════════════════
# ORCHESTRATION-HAS-DECISION: OC1 → OD1-OD5
# ════════════════════════════════════════════════════════════════════════════════

(od-orchestration: $OC1, od-record: $OD1) isa orchestration-has-decision;
(od-orchestration: $OC1, od-record: $OD2) isa orchestration-has-decision;
(od-orchestration: $OC1, od-record: $OD3) isa orchestration-has-decision;
(od-orchestration: $OC1, od-record: $OD4) isa orchestration-has-decision;
(od-orchestration: $OC1, od-record: $OD5) isa orchestration-has-decision;

# ════════════════════════════════════════════════════════════════════════════════
# TEMPLATE-HAS-INSTANCE: Types → Instances
# ════════════════════════════════════════════════════════════════════════════════

(tt-type: $TT_Input, ti-record: $TI_01) isa template-has-instance;
(tt-type: $TT_Input, ti-record: $TI_02) isa template-has-instance;
(tt-type: $TT_Input, ti-record: $TI_03) isa template-has-instance;

(tt-type: $TT_Output, ti-record: $TI_04) isa template-has-instance;
(tt-type: $TT_Output, ti-record: $TI_05) isa template-has-instance;
(tt-type: $TT_Output, ti-record: $TI_06) isa template-has-instance;
(tt-type: $TT_Output, ti-record: $TI_07) isa template-has-instance;
(tt-type: $TT_Output, ti-record: $TI_08) isa template-has-instance;

(tt-type: $TT_Handoff, ti-record: $TI_09) isa template-has-instance;
(tt-type: $TT_Handoff, ti-record: $TI_10) isa template-has-instance;

(tt-type: $TT_Verification, ti-record: $TI_11) isa template-has-instance;

(tt-type: $TT_Decision, ti-record: $TI_12) isa template-has-instance;

# ════════════════════════════════════════════════════════════════════════════════
# SUBTASK-HAS-FALLBACK: Subtasks → Fallback tiers (Tier 1-3 only)
# Tier 4 halt conditions are system-level, not linked to specific subtasks
# ════════════════════════════════════════════════════════════════════════════════

# Tier 1: Retry Same Agent
(fallback-subtask: $T1_1, ft-record: $FT1_1) isa subtask-has-fallback;
(fallback-subtask: $T2_1, ft-record: $FT1_2) isa subtask-has-fallback;
(fallback-subtask: $T5_1, ft-record: $FT1_3) isa subtask-has-fallback;
(fallback-subtask: $T5_2, ft-record: $FT1_4) isa subtask-has-fallback;

# Tier 2: Retry Restricted
(fallback-subtask: $T1_2, ft-record: $FT2_1) isa subtask-has-fallback;
(fallback-subtask: $T2_2, ft-record: $FT2_2) isa subtask-has-fallback;
(fallback-subtask: $T5_3, ft-record: $FT2_3) isa subtask-has-fallback;
(fallback-subtask: $T8_2, ft-record: $FT2_4) isa subtask-has-fallback;

# Tier 3: Escalate Human
(fallback-subtask: $T1_1, ft-record: $FT3_1) isa subtask-has-fallback;
(fallback-subtask: $T1_3, ft-record: $FT3_2) isa subtask-has-fallback;
(fallback-subtask: $T1_5, ft-record: $FT3_3) isa subtask-has-fallback;
(fallback-subtask: $T3_1, ft-record: $FT3_4) isa subtask-has-fallback;
(fallback-subtask: $T5_3, ft-record: $FT3_5) isa subtask-has-fallback;
(fallback-subtask: $T8_4, ft-record: $FT3_6) isa subtask-has-fallback;