# ── OpenAI API key (for knowledge embeddings) ────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── Ollama API key (for local LLM interactions) ───────────────────────────────
OLLAMA_API_KEY=your-ollama-api-key-here

# ── Supabase (agent spec storage) ────────────────────────────────────────────
# Session pooler connection string — from Supabase Dashboard → Settings → Database → Connection string
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

# Your Supabase auth user UUID — from Supabase Dashboard → Authentication → Users
AGENT_SPEC_USER_ID=your-supabase-user-uuid-here

# Default design system UUID — leave blank on first run; the Agent Designer will create one
AGENT_SPEC_DESIGN_SYSTEM_ID=